# Copy to .env and fill in.
# Yandex Maps JavaScript API + Geocoder key — get one at https://developer.tech.yandex.ru/services
# The key MUST have "JavaScript API and Geocoder API" enabled, and should be
# restricted by HTTP-Referer to your Mini App domain in the Yandex cabinet.
VITE_YANDEX_MAPS_KEY=your-yandex-maps-js-api-key

# Backend base URL (no trailing slash). e.g. https://api.smartfood.uz/api/v1
VITE_API_BASE=/api/v1
