# Copy to .env and fill in. Vite inlines VITE_* vars into the bundle at build time.

# ── Frontend (build-time) ───────────────────────────────────────────────────
# Yandex Maps JavaScript API + Geocoder key — get one at
# https://developer.tech.yandex.ru/services
# The key MUST have "JavaScript API and Geocoder API" enabled, and should be
# restricted by HTTP-Referer to your Mini App domain in the Yandex cabinet.
# Client map keys are public by design (they ship in the browser).
VITE_YANDEX_MAPS_KEY=your-yandex-maps-js-api-key

# Smart Food customer API base (no trailing slash). Keep it a same-origin path in
# production so nginx can reverse-proxy it (no CORS). Point it at a full origin
# (https://host/api/smartfood) only when calling a remote backend directly.
VITE_API_BASE=/api/smartfood

# Order-tracking poll interval in ms (default 8000).
VITE_TRACK_POLL_MS=8000

# ── Local development only ──────────────────────────────────────────────────
# Where `npm run dev` proxies /api/smartfood (so the browser stays same-origin).
VITE_DEV_API_TARGET=https://pos.78.111.90.65.nip.io

# Optional: a captured Telegram initData string, to authenticate from a desktop
# browser during development. Leave empty in real deployments — the Mini App
# reads window.Telegram.WebApp.initData inside Telegram.
# (You can also pass it per-visit via the URL: ?init_data=<captured-string>)
# VITE_DEV_INIT_DATA=

# Allow opening in a plain browser (outside Telegram): the app boots, probes the
# live backend and shows reachability instead of the "open from Telegram" wall.
# Default on. Set to 0 to enforce Telegram-only gating (production).
VITE_ALLOW_BROWSER=1

# ── Deployment (Docker / nginx — see deploy.sh & docker-compose.yml) ─────────
# Canonical customer-facing URL. Telegram and the backend must use this exact URL.
PUBLIC_WEBAPP_URL=https://delivery.78.111.90.65.nip.io/webapp/
# Shared Docker network used by Caddy to reach the webapp as `delivery-webapp`.
EDGE_NETWORK=edge
# Backend origin the /api/smartfood path is reverse-proxied to.
BACKEND_ORIGIN=https://pos.78.111.90.65.nip.io
# Host port the container publishes (container listens on 80).
WEBAPP_PORT=8080
